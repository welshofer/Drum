+#!/bin/bash
+# Ordinary app build/regression checks. Performance workloads have their own runner.
+set -euo pipefail
+repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
+usage() {
+  cat <<'USAGE'
+Usage: scripts/check-project.sh <build|test> <Debug|Release> [options]
+  --output-dir DIR          Fresh directory for xcodebuild.log (default: build/checks/…)
+  --allow-reviewed-plugin   Skip Xcode plugin validation for this invocation only.
+                           Use only after reviewing the locked dependency/plugin.
+  --help                   Show this help.
+USAGE
+}
+fail() { printf '%s\n' "$1" >&2; exit 2; }
+if [[ "${1:-}" == --help ]]; then usage; exit 0; fi
+[[ $# -ge 2 ]] || { usage >&2; exit 2; }
+action="$1"
+configuration="$2"
+shift 2
+case "$action" in build|test) ;; *) fail 'Action must be build or test.' ;; esac
+case "$configuration" in Debug|Release) ;; *) fail 'Configuration must be Debug or Release.' ;; esac
+output_dir="$repo_dir/build/checks/$(date -u +%Y%m%dT%H%M%SZ)-$$"
+allow_plugin=0
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output-dir)
+      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail '--output-dir requires a directory.'
+      output_dir="$2"; shift 2 ;;
+    --allow-reviewed-plugin) allow_plugin=1; shift ;;
+    *) fail "Unknown option: $1" ;;
+  esac
+done
+for tool in xcodebuild xcrun; do
+  command -v "$tool" >/dev/null || fail "Missing $tool. Select a full Xcode installation; see docs/development.md."
+done
+if ! xcode_version="$(xcodebuild -version 2>&1)"; then
+  printf '%s\n' "$xcode_version" >&2
+  fail 'Selected developer directory cannot run Xcode. See docs/development.md.'
+fi
+if ! metal_path="$(xcrun --no-cache --find metal 2>/dev/null)" || [[ ! -x "$metal_path" ]]; then
+  fail 'Metal toolchain unavailable for selected Xcode. Install its matching Metal Toolchain; see docs/development.md.'
+fi
+mkdir -p "$output_dir"
+output_dir="$(cd "$output_dir" && pwd)"
+log="$output_dir/xcodebuild.log"
+[[ ! -e "$log" ]] || fail "Refusing to replace existing log: $log"
+cd "$repo_dir"
+args=(-project Drum.xcodeproj -scheme Drum -configuration "$configuration"
+      -destination "platform=macOS,arch=$(uname -m)" -disableAutomaticPackageResolution
+      ONLY_ACTIVE_ARCH=YES)
+if [[ "$allow_plugin" == 1 ]]; then
+  printf '%s\n' 'Plugin validation bypass explicitly selected; it covers every package plugin in this invocation.' >&2
+  args+=(-skipPackagePluginValidation)
+fi
+if [[ "$action" == test ]]; then
+  args+=(-skip-testing:DrumTests/TerminalPerformanceTests)
+  [[ "$configuration" != Release ]] || args+=(ENABLE_TESTABILITY=YES)
+fi
+printf '%s\nLog: %s\n' "$xcode_version" "$log"
+# Preserve xcodebuild's exit code, independent of filtering/tee.
+status=0
+xcodebuild "${args[@]}" "$action" > "$log" 2>&1 || status=$?
+if [[ "$status" != 0 ]]; then
+  tail -n 40 "$log" >&2
+  printf 'xcodebuild failed (exit %s). Full log: %s\n' "$status" "$log" >&2
+  exit "$status"
+fi
+if LC_ALL=C grep -Ein '(^|[[:space:]])warning:' "$log"; then
+  printf 'xcodebuild succeeded, but the zero-warning gate failed. Full log: %s\n' "$log" >&2
+  exit 3
+fi
+printf '%s %s succeeded with zero warnings. Log: %s\n' "$configuration" "$action" "$log"
